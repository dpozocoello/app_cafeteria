<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CafeteriaPos"
        android:usesCleartextTraffic="true">

        <!-- 1. Configuración del servidor (launcher) -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Login del mesero -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Menú principal -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- 4. Selección de mesa / tipo de servicio -->
        <activity
            android:name=".TableSelectorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Carta de menús y carrito -->
        <activity
            android:name=".MenuActivity"
            android:exported="false" />

        <!-- 6. Pedidos activos del mesero -->
        <activity
            android:name=".ActiveOrdersActivity"
            android:exported="false" />

        <!-- MainActivity mantenida como WebView de respaldo (sin uso en flujo principal) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
