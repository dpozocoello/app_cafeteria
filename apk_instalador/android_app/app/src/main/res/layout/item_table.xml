<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/table_free_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp"
        android:minHeight="90dp">

        <!-- Número de mesa grande -->
        <TextView
            android:id="@+id/tvTableNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/table_free_text"
            android:layout_marginBottom="2dp"/>

        <!-- Capacidad -->
        <TextView
            android:id="@+id/tvCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 pers."
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="4dp"/>

        <!-- Estado de la mesa -->
        <TextView
            android:id="@+id/tvTableStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Libre"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/table_free_text"/>

        <!-- Zona (si aplica) -->
        <TextView
            android:id="@+id/tvZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="@color/text_hint"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
