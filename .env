# =============================================================================
# CoffeeApp - Configuración Central
# =============================================================================
# Copia este archivo como .env y ajusta los valores. NO lo subas a Git.

# ─── Motor de Base de Datos ───────────────────────────────────────────────────
# Opciones: sqlite | postgresql | mysql
DB_ENGINE=sqlite

# SQLite (solo desarrollo)
SQLITE_PATH=./coffee_app_v2.db

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=coffeeapp
PG_USER=postgres
PG_PASSWORD=secret

# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=coffeeapp
MYSQL_USER=root
MYSQL_PASSWORD=secret

# ─── Identidad Gráfica (Design Tokens) ───────────────────────────────────────
BRAND_NAME=YUQUI - Piqueos & Cafeteria
BRAND_TAGLINE=Ecuatoriano de verdad

# Colores (hex)
COLOR_BG=#0a0a0a
COLOR_SIDEBAR=#171717
COLOR_CARD=rgba(38,38,38,0.5)
COLOR_ACCENT=#e29323
COLOR_TEXT=#fafafa
COLOR_MUTED=#a3a3a3
COLOR_SUCCESS=#10b981
COLOR_DANGER=#ef4444

# Tipografía (nombre de Google Font)
FONT_FAMILY=Montserrat

# Características de Marca (Parámetros YUQUI)
BRAND_PERSONALITY=Joven, orgulloso, directo, auténtico, viral
BRAND_VISUALS=Icono estilizado pan de yuca, tipografía fuerte, fotografía de producto
BRAND_PACKAGING=Funda Ziploc con logo impreso, sticker circular negro/amarillo, QR de Instagram
BRAND_TONE=Pan de yuca como lo hacía la abuela. Ahora con entrega a domicilio.
BRAND_CHANNELS=Instagram, TikTok, apps de delivery, markets modernos, ferias gastronómicas

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=true
