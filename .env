# =============================================================================
# Sistema POS - Configuración Central
# =============================================================================
# Copia este archivo como .env y ajusta los valores. NO lo subas a Git.

# ─── Motor de Base de Datos ───────────────────────────────────────────────────
# Opciones: sqlite | postgresql | mysql
DB_ENGINE=sqlite

# SQLite (solo desarrollo)
SQLITE_PATH=./pos_app.db

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pos_app
PG_USER=postgres
PG_PASSWORD=secret

# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pos_app
MYSQL_USER=root
MYSQL_PASSWORD=secret

# ─── Identidad Gráfica (Design Tokens) ───────────────────────────────────────
BRAND_NAME=Antigravity Coffee
BRAND_TAGLINE=Café de especialidad · Quito

# Colores (hex)
COLOR_BG=#020617
COLOR_SIDEBAR=#0f172a
COLOR_CARD=rgba(30,41,59,0.5)
COLOR_ACCENT=#fbbf24
COLOR_TEXT=#f8fafc
COLOR_MUTED=#94a3b8
COLOR_SUCCESS=#10b981
COLOR_DANGER=#ef4444

# Tipografía (nombre de Google Font)
FONT_FAMILY=Outfit

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=true

# ─── Licenciamiento ───────────────────────────────────────────────────────────
# Días de período de prueba (1–30). Valores superiores a 30 se limitan a 30.
TRIAL_DAYS=15
# Fecha de instalación — se registra automáticamente en el primer arranque.
# Formato YYYY-MM-DD. No modificar manualmente.
INSTALLATION_DATE=2026-06-09
