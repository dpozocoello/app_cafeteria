# =============================================================================
# CoffeeApp - Configuración Central
# =============================================================================
# Copia este archivo como .env y ajusta los valores. NO lo subas a Git.

# ─── Motor de Base de Datos ───────────────────────────────────────────────────
# Opciones: sqlite | postgresql | mysql
DB_ENGINE=sqlite

# SQLite (solo desarrollo)
SQLITE_PATH=./coffee_app_v2.db

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=coffeeapp
PG_USER=postgres
PG_PASSWORD=secret

# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=coffeeapp
MYSQL_USER=root
MYSQL_PASSWORD=secret

# ─── Identidad Gráfica (Design Tokens) ───────────────────────────────────────
BRAND_NAME=Coffee-Restaurant
BRAND_TAGLINE=Café de especialidad · Quito

# Colores (hex)
COLOR_BG=#020617
COLOR_SIDEBAR=#0f172a
COLOR_CARD=rgba(30,41,59,0.5)
COLOR_ACCENT=#fbbf24
COLOR_TEXT=#f8fafc
COLOR_MUTED=#4789e6
COLOR_SUCCESS=#10b981
COLOR_DANGER=#ef4444

# Tipografía (nombre de Google Font)
FONT_FAMILY=Raleway

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=true
